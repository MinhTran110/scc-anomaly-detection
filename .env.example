# Database 1 (Internal Container / Port 5433)
DB1_HOST=db
DB1_PORT=5433
DB1_NAME=scc_calls
DB1_USER=postgres
DB1_PASSWORD=your_postgres_password

# Database 2 (Host / Port 5432)
DB2_HOST=host.docker.internal
DB2_PORT=5432
DB2_NAME=postgres
DB2_USER=postgres
DB2_PASSWORD=your_host_password

# Telegram Notification (Optional)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_IDS=your_chat_id_1,your_chat_id_2
